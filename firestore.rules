rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDocente() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
    }
    function esAdmin() {
      return esDocente() &&
        get(/databases/$(database)/documents/docentes/$(request.auth.uid)).data.rol == 'admin';
    }

    // Código de acceso: nadie puede leerlo ni cambiarlo desde la página
    match /config/{d} {
      allow read, write: if false;
    }

    // Perfil de cada docente
    match /docentes/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.rol == 'docente'
        && request.resource.data.codigo == get(/databases/$(database)/documents/config/acceso).data.codigo;
      allow update, delete: if false;
    }

    // Puntos
    match /registros/{id} {
      allow read: if esDocente();
      allow create: if esDocente()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['favor', 'contra']
        && request.resource.data.pts is int
        && request.resource.data.pts > 0
        && request.resource.data.pts <= 1000;
      allow delete: if esDocente() && (resource.data.uid == request.auth.uid || esAdmin());
      allow update: if false;
    }
  }
}
